        Label:
            id: Name
            text: ""
            color: (0, 0, 0, 1)
            allow_stretch: True
            pos_hint: {'center_x': 0.5, 'center_y': 0.690}
            size_hint: 0.95, 0.6
            text_size: self.size
            font_size: 50
            font_name: "font/tai_normal.ttf"
            halign: 'center'
            valign: 'top'

        Label:
            id: MenuName
            text: "Choose Starter"
            color: (1, 1, 1, 1)
            allow_stretch: True
            pos_hint: {'center_x': 0.15, 'center_y': 0.690}
            size_hint: 0.95, 0.6
            text_size: self.size
            font_size: 40
            font_name: "font/tai_normal.ttf"
            halign: 'center'
            valign: 'top'

        PixelImage:
