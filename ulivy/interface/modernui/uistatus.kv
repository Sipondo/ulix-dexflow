            pos_hint: {"center_x": 0.7, "center_y": 0.95}

        PixelImage:
            id: Battler_Type2
            source: 'ulivy/interface/modernui/types/ice.png'
            pos_hint: {"center_x": 0.7, "center_y": 0.905}

        PixelImage:
            id: ArrowLeft
            opacity: 0.6
            source: 'ulivy/interface/modernui/arrowleft.png'
            pos_hint: {"center_x": 0.02, "center_y": 0.5}
            size_hint: (0.1, 0.1)
            allow_stretch: True
        
        PixelImage:
            id: ArrowRight
            opacity: 0.6
            source: 'ulivy/interface/modernui/arrowright.png'
            pos_hint: {"center_x": 0.98, "center_y": 0.5}
            size_hint: (0.1, 0.1)
            allow_stretch: True

