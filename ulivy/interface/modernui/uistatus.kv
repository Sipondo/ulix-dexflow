#:kivy 2.0.0

<UIStatus>
    # UI START

    PixelImage:
        id: Background
        source: 'ulivy/interface/modernui/black.png'
        opacity: 0.7

    FloatLayout:
        id: Overlay
        opacity: 0

        PixelImage:
            id: BackgroundMember
            source: 'ulivy/interface/modernui/bg_menumove.png'

        FloatLayout:
            id: ItemInfo

        FloatLayout:
            id: BattlerInfo
            


            PixelImage:
                id: Card
                source: 'resources/simple/graphics/cards/pikachu.png'
                pos_hint: {"center_x": 0.9, "y": 0.06}
                size_hint: (0.8, 0.8)
                allow_stretch: True

            FloatLayout:
                id: MoveSelector
            
                FloatLayout:
                    id: Move1
                    size: 400, 175
                    pos_hint: {"center_x": 0.5, "y": -0.3}

                    PixelImage:
                        id: Move1_Base
                        source: 'ulivy/interface/modernui/moveborderbase.png'
                        pos_hint: {"center_x": 0.48, "center_y": 0.5}

                    PixelImage:
                        id: Move1_Border
                        source: 'ulivy/interface/modernui/moveborder.png'
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    Label:
                        id: Move1_Prefix
                        text: ""
                        color: (1, 1, 1, 1)
                        size: 350, 100
                        size_hint: None, None
                        pos_hint: {"center_x": 0.5, "center_y": 0.65}
                        text_size: self.size
                        font_size: 18
                        font_name: "font/tai_normal.ttf"

                    Label:
                        id: Move1_Name
                        text: "Flamethrower"
                        color: (1, 1, 1, 1)
                        size: 350, 100
                        size_hint: None, None
                        pos_hint: {"center_x": 0.5, "center_y": 0.61}
                        text_size: self.size
                        font_size: 24
                        font_name: "font/tai_normal.ttf"

                    PixelImage:
                        id: Move1_Type
                        source: 'ulivy/interface/modernui/types/fire.png'
                        pos_hint: {"center_x": 0.56, "center_y": 0.597}
                        # size_hint: (0.8, 0.8)
                        # allow_stretch: True

                    PixelImage:
                        id: Move1_Category
                        source: 'ulivy/interface/modernui/types/special.png'
                        pos_hint: {"center_x": 0.56, "center_y": 0.561}
                        # size_hint: (0.8, 0.8)
                        # allow_stretch: True

                    Label:
                        id: Move1_PP
                        text: "-"
                        color: (1, 1, 1, 1)
                        size: 50, 50
                        size_hint: None, None
                        pos_hint: {"center_x": 0.63, "center_y": 0.585}
                        text_size: self.size
                        font_size: 30
                        font_name: "font/tai_normal.ttf"
                    
                    Label:
                        id: Move1_Description
                        text: "Deal heavy damage. Deals double damage."
                        color: (0, 0, 0, 1)
                        size: 350, 100
                        size_hint: None, None
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        text_size: self.size
                        font_size: 18
                        font_name: "font/tai_normal.ttf"


