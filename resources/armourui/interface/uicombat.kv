                # ATTACK MENU
                RelativeLayout:
                    id: BattleAttack
                    pos_hint: {'center_x': 0.82, 'y': 0.05}
                    size_hint: 0.57, 0.3

                    AliasImage:
                        id: BattleAttackCell
                        allow_stretch: True
                        source: 'resources/basicui/graphics/interface/battle/attackwindow.png'

                    RelativeLayout:
                        id: BattleAttackA
                        pos_hint: {'center_x': 0.5, 'center_y': 0.75}
                        size_hint: 1, 0.213                        

                        AliasImage:
                            id: BattleAttackAType
                            allow_stretch: True
                            pos_hint: {'center_x': 0.265, 'center_y': 0.5}
                            size_hint: 0.9, 0.9
                            source: 'resources/basicui/graphics/interface/battle/attack_types/attack_normal.png'

                        AliasImage:
                            id: BattleAttackACell
                            allow_stretch: True
                            source: 'resources/basicui/graphics/interface/battle/attackcell.png'

                        Label:
                            id: BattleAttackAName
                            text: "Test Name! Yes!"
                            color: (0, 0, 0, 1)
                            allow_stretch: True
                            pos_hint: {'center_x': 0.78, 'center_y': 0.52}
                            size_hint: 0.95, 0.75
                            text_size: self.size
                            font_size: self.parent.parent.parent.parent.parent.fsize
                            font_name: "font/tai_normal.ttf"
                            halign: 'left'
                            valign: 'top'

                        Label:
                            id: BattleAttackACharges
                            text: "40"
                            color: (0, 0, 0, 1)
                            allow_stretch: True
                            pos_hint: {'center_x': 0.755, 'center_y': 0.5}
                            size_hint: 0.1, 0.75
                            text_size: self.size
                            font_size: self.parent.parent.parent.parent.parent.fsize
                            font_name: "font/tai_normal.ttf"
                            halign: 'left'
                            valign: 'top'

                        
