                        AliasImage:
                            id: BattleTopItemCell
                            # allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action.png'

                        AliasImage:
                            id: BattleTopItemIcon
                        #     allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action_bag.png'


                    RelativeLayout:
                        id: BattleTopRun
                        pos_hint: {'center_x': 0.5, 'center_y': 0.1}

                        AliasImage:
                            id: BattleTopRunCell
                            # allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action.png'

                        AliasImage:
                            id: BattleTopRunIcon
                        #     allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action_run.png'

