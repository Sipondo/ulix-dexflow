#:kivy 2.0.0

<UICombat>
    AliasImage:
        # Don't worry about any of this stuff. It just makes sure the game screen is 16:9.
        # Got this from the guys over at Kivy.
        id: BackgroundId
        source: 'resources/armourui/graphics/interface/gamebounds.png'
        allow_stretch: True
        size: self.parent.size
        offset: [self.center_x - (self.norm_image_size[0]/2), self.center_y - (self.norm_image_size[1]/2)]
        magnification: self.norm_image_size[0] / self.texture_size[0]
        fsize: 24 * self.magnification

        FloatLayout:
            pos: self.parent.offset
            size: self.parent.norm_image_size

            # UI START

  # DIALOGUE BOX
            RelativeLayout:
                id: DialogueWindow
                pos_hint: {'center_y': 0.5, 'center_x': 0.5}
                pos_hint: {'x': 0.05, 'y': 0.01}
                size_hint: 0.6, 0.2

                AliasImage:
                    id: DialogueBackground
                    allow_stretch: True
                    source: 'resources/armourui/graphics/interface/dialogue_window.png'
                
                Label:
                    id: DialogueText
                    text: ""
                    color: (0, 0, 0, 1)
                    allow_stretch: True
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    size_hint: 0.95, 0.6
                    text_size: self.size
                    font_size: self.parent.parent.parent.fsize
                    font_name: "font/tai_normal.ttf"
                    halign: 'left'
                    valign: 'top'

  # DIALOGUE BOX
            RelativeLayout:
                id: PromptWindow
                pos_hint: {'center_y': 0.5, 'center_x': 0.5}
                size_hint: 1, 1

                # STATUS
                RelativeLayout:
                    id: BattleStatus
                    pos_hint: {'center_x': 0.5, 'y': 0.7}
                    size_hint: 0.9, 0.35

                    RelativeLayout:
                        id: BattleStatusOurs
                        pos_hint: {'center_x': 0.22, 'center_y': 0.5}
                        size_hint: 0.5, 1

                        AliasImage:
                            id: BattleStatusOursHPBack
                            allow_stretch: True
                            keep_ratio: False
                            pos_hint: {'x': 0.08, 'center_y': 0.42}
                            size_hint: 0.9, 0.15
                            source: 'resources/basicui/graphics/interface/battle/greybar.png'

                        AliasImage:
                            id: BattleStatusOursHP
                            allow_stretch: True
                            keep_ratio: False
                            pos_hint: {'x': 0.08, 'center_y': 0.42}
                            size_hint: 0.9, 0.15
                            source: 'resources/basicui/graphics/interface/battle/greenbar.png'

                        AliasImage:
                            id: BattleStatusOursCell
                            allow_stretch: True
                            source: 'resources/basicui/graphics/interface/battle/battlestatus_ours.png'
                        
                        Label:
                            id: BattleStatusOursName
                            text: "Battlerman Ours"
                            color: (0, 0, 0, 1)
                            allow_stretch: True
                            pos_hint: {'center_x': 0.51, 'center_y': 0.34}
                            size_hint: 0.95, 0.65
                            text_size: self.size
                            font_size: self.parent.parent.parent.parent.parent.fsize
                            font_name: "font/tai_normal.ttf"
                            halign: 'left'
                            valign: 'top'
                    
                        AliasImage:
                            id: BattleStatusOursPoison
                            pos_hint: {'x': -0.37, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_poison.png'
                        
                        AliasImage:
                            id: BattleStatusOursBurn
                            pos_hint: {'x': -0.29, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_burn.png'
                        
                        AliasImage:
                            id: BattleStatusOursParalysis
                            pos_hint: {'x': -0.21, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_paralysis.png'
                        
                        AliasImage:
                            id: BattleStatusOursFreeze
                            pos_hint: {'x': -0.13, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_freeze.png'


                    
                    RelativeLayout:
                        id: BattleStatusTheirs
                        pos_hint: {'center_x': 0.78, 'center_y': 0.5}
                        size_hint: 0.5, 1


                        AliasImage:
                            id: BattleStatusTheirsHPBack
                            allow_stretch: True
                            keep_ratio: False
                            pos_hint: {'x': 0.02, 'center_y': 0.42}
                            size_hint: 0.9, 0.15
                            source: 'resources/basicui/graphics/interface/battle/greybar.png'

                        AliasImage:
                            id: BattleStatusTheirsHP
                            allow_stretch: True
                            keep_ratio: False
                            pos_hint: {'x': 0.02, 'center_y': 0.42}
                            size_hint: 0.9, 0.15
                            source: 'resources/basicui/graphics/interface/battle/greenbar.png'

                        AliasImage:
                            id: BattleStatusTheirsCell
                            allow_stretch: True
                            source: 'resources/basicui/graphics/interface/battle/battlestatus_theirs.png'

                        Label:
                            id: BattleStatusTheirsName
                            text: "Battlerman Theirs"
                            color: (0, 0, 0, 1)
                            allow_stretch: True
                            pos_hint: {'center_x': 1.15, 'center_y': 0.34}
                            size_hint: 0.95, 0.65
                            text_size: self.size
                            font_size: self.parent.parent.parent.parent.parent.fsize
                            font_name: "font/tai_normal.ttf"
                            halign: 'left'
                            valign: 'top'

                        AliasImage:
                            id: BattleStatusTheirsPoison
                            pos_hint: {'x': 0.37, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_poison.png'
                        
                        AliasImage:
                            id: BattleStatusTheirsBurn
                            pos_hint: {'x': 0.29, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_burn.png'
                        
                        AliasImage:
                            id: BattleStatusTheirsParalysis
                            pos_hint: {'x': 0.21, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_paralysis.png'
                        
                        AliasImage:
                            id: BattleStatusTheirsFreeze
                            pos_hint: {'x': 0.13, 'center_y': 0.3775}
                            source: 'resources/basicui/graphics/interface/types/status_freeze.png'


                # TOP MENU
                RelativeLayout:
                    id: BattleTop
                    pos_hint: {'x': 0.75, 'y': 0.01}
                    size_hint: 0.3, 0.45

                    RelativeLayout:
                        id: BattleTopAttack
                        pos_hint: {'center_x': 0.5, 'center_y': 0.85}

                        AliasImage:
                            id: BattleTopAttackCell
                            # allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action.png'

                        AliasImage:
                            id: BattleTopAttackIcon
                        #     allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action_fight.png'
                    
                    RelativeLayout:
                        id: BattleTopSwitch
                        pos_hint: {'center_x': 0.5, 'center_y': 0.6}

                        AliasImage:
                            id: BattleTopSwitchCell
                            # allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action.png'

                        AliasImage:
                            id: BattleTopSwitchIcon
                            # allow_stretch: True
                            source: 'resources/armourui/graphics/interface/battle/action_mon.png'
                    
                    RelativeLayout:
