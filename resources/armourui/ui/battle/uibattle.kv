        RelativeLayout:
            id: Options

            AliasImage:
                id: OptionFight
                pos_hint: {'center_x': 0.9, 'center_y': 0.36}
                allow_stretch: True
                keep_ratio: True
                source: 'resources/armourui/graphics/interface/battle/option_fight.png'

            AliasImage:
                id: OptionMon
                pos_hint: {'center_x': 0.9, 'center_y': 0.26}
                allow_stretch: True
                keep_ratio: True
                source: 'resources/armourui/graphics/interface/battle/option_mon.png'

