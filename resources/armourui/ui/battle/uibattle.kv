        RelativeLayout:
            id: OurStatus

            RelativeLayout:
                id: OurMonFirst
                pos_hint: {'center_x': 0.125, 'y': -0.46}
                allow_stretch: True

                AliasImage:
                    id: OurMonFirstBack
                    pos_hint: {'center_x': 0.5, 'y': 0.5}
                    allow_stretch: True
                    keep_ratio: True
                    source: 'resources/armourui/graphics/interface/battle/our_mon_first.png'

                Label:
                    id: OurMonFirstText
                    pos_hint: {'center_x': 0.5, 'y': 0.5}
                    size_hint: 0.1, 0.1
                    text: "Bulbasaur"
                    text_size: self.size
                    font_size: 36
                    font_name: "resources/armourui/font/poppins_medium.ttf"
                    halign: 'left'
                    color: (0, 0, 0, 1)
                    valign: 'top'
                    markup: True

            # AliasImage:
