        RelativeLayout:
            id: TheirStatus

            RelativeLayout:
                id: TheirMonFirst
                pos_hint: {'center_x': 0.875, 'y': 0.42}
                allow_stretch: True

                AliasImage:
                    id: TheirMonFirstBack
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    allow_stretch: True
                    keep_ratio: True
                    source: 'resources/armourui/graphics/interface/battle/their_mon_first.png'
                
                Label:
                    id: TheirMonFirstText
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    size_hint: 0.1, 0.1
                    text: "Venusaur"
                    text_size: self.size
                    font_size: 36
                    font_name: "resources/armourui/font/poppins_medium.ttf"
                    halign: 'left'
                    color: (0, 0, 0, 1)
                    valign: 'top'
                    markup: True

