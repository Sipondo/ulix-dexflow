#:kivy 2.0.0

<MonCell>
    RelativeLayout:
        id: Window
        
        AliasImage:
            id: Background
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            allow_stretch: True
            keep_ratio: True
            source: 'resources/armourui/graphics/interface/mon/mon_cell.png'               

        AliasImage:
            id: HpBarBackground
            pos_hint: {'x': 0.22, 'center_y': 0.5}
            allow_stretch: True
            keep_ratio: False
            source: 'resources/armourui/graphics/interface/mon/bar_grey.png'      
        
        AliasImage:
            id: HpBar
            pos_hint: {'x': 0.22, 'center_y': 0.5}
            allow_stretch: True
            keep_ratio: False
            source: 'resources/armourui/graphics/interface/mon/bar_green.png'      
        
        Label:
            id: Name
            pos_hint: {'center_x': 0.525, 'center_y': 0.8}
            size_hint: 0.6, 0.35
            text: "Crabominable 999"
            text_size: self.size
            font_size: 36
            font_name: "resources/armourui/font/poppins_medium.ttf"
            color: (1, 1, 1, 1)
            markup: True
        
        Label:
            id: Hp
            pos_hint: {'center_x': 0.525, 'center_y': 0.2}
            size_hint: 0.6, 0.35
            text: "999/999"
            text_size: self.size
            font_size: 36
            font_name: "resources/armourui/font/poppins_medium.ttf"
            color: (1, 1, 1, 1)
            markup: True
        
        Label:
            id: Level
            pos_hint: {'center_x': 0.9, 'center_y': 0.2}
            size_hint: 0.3, 0.35
            text: "Lv. 999"
            text_size: self.size
            font_size: 36
            font_name: "resources/armourui/font/poppins_medium.ttf"
            color: (1, 1, 1, 1)
            markup: True  
        
        AliasImage:
            id: Gender
            pos_hint: {'center_x': 0.78, 'center_y': 0.77}
            allow_stretch: True
            keep_ratio: True
            source: 'resources/armourui/graphics/interface/mon/female.png'      

        PixelImage:
            id: Icon
            pos_hint: {'center_x': 0.125, 'center_y': 0.5}
            size_hint: 0.75, 0.75
            allow_stretch: True
            keep_ratio: True
            source: 'resources/essentials/graphics/icons/000_0.png'     


<UIMonView>
    RelativeLayout:
        id: Window
        opacity: 1


        AliasImage:
            id: Background
            allow_stretch: True
            keep_ratio: True
            source: 'resources/armourui/graphics/interface/mon/background.png'

        # AliasImage:
        #     id: OverlayTop
        #     allow_stretch: True
        #     keep_ratio: True
        #     pos_hint: {'center_x': 0.682, 'center_y': 0.935}
        #     source: 'resources/armourui/graphics/interface/mon/overlay_top.png'

        PixelImage:
            id: Splash
            pos_hint: {'center_x': 0.7, 'center_y': 0.38}
            resized: True
            allow_stretch: True
            keep_ratio: True
            source: 'resources/essentials/graphics/mon_static/front/000.png'
            
        AliasImage:
            id: Overlay
            allow_stretch: True
            keep_ratio: True
            pos_hint: {'center_x': 0.206, 'center_y': 0.5}
            source: 'resources/armourui/graphics/interface/mon/overlay_view.png'

        AliasImage:
            id: InfoPanel
            pos_hint: {'center_x': 0.5, 'center_y': 0.02}
            allow_stretch: True
            keep_ratio: True
            source: 'resources/armourui/graphics/interface/mon/info_panel.png'

        AliasImage:
            id: BallLogo
            pos_hint: {'center_x': 0.05, 'center_y': 0.91}
            allow_stretch: True
            keep_ratio: True
            source: 'resources/armourui/graphics/interface/mon/ball_logo.png'


        Label:
            id: Name
            pos_hint: {'center_x': 0.24, 'center_y': 0.945}
            size_hint: 0.3, 0.2
            text: "[color=000000]POKÉMON[/color]"
            text_size: self.size
            font_size: 96
            font_name: "resources/armourui/font/poppins_bold.ttf"
            markup: True

        RelativeLayout:
            id: Mons

            MonCell:
                id: Mon1
                allow_stretch: True
                keep_ratio: True
                size_hint: 0.308, 0.118
                pos_hint: {'center_x': 0.2, 'center_y': 0.79}

            MonCell:
                id: Mon2
                allow_stretch: True
                keep_ratio: True
                size_hint: 0.308, 0.118
                pos_hint: {'center_x': 0.2, 'center_y': 0.66}

            MonCell:
                id: Mon3
                allow_stretch: True
                keep_ratio: True
                size_hint: 0.308, 0.118
                pos_hint: {'center_x': 0.2, 'center_y': 0.53}

            MonCell:
                id: Mon4
                allow_stretch: True
                keep_ratio: True
                size_hint: 0.308, 0.118
                pos_hint: {'center_x': 0.2, 'center_y': 0.4}

            MonCell:
                id: Mon5
                allow_stretch: True
                keep_ratio: True
                size_hint: 0.308, 0.118
                pos_hint: {'center_x': 0.2, 'center_y': 0.27}

            MonCell:
                id: Mon6
                allow_stretch: True
                keep_ratio: True
                size_hint: 0.308, 0.118
                pos_hint: {'center_x': 0.2, 'center_y': 0.14}

        AliasImage:
            id: Arrow
            size_hint: 0.025, 0.065
            pos_hint: {'center_x': 0.075, 'center_y': 0.75}
            allow_stretch: True
            keep_ratio: True
            source: 'resources/armourui/graphics/interface/general/arrow.png'
