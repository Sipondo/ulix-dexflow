#:kivy 2.0.0

<UICinematic>
    PixelImage:
        id: TalkerSprite
        resized: True
        pos_hint: {'y': 0, 'center_x': 0.7}
        size_hint: 0.8, 0.8
        allow_stretch: True

# DIALOGUE BOX
    RelativeLayout:
        id: DialogueWindow
        pos_hint: {'center_y': 0.5, 'center_x': 0.5}
        pos_hint: {'x': 0.18, 'y': 0.01}
        size_hint: 0.6, 0.2

        PixelImage:
            id: DialogueBackground
            allow_stretch: True
            source: 'resources/armourui/graphics/interface/textbox.png'
        
        Label:
            id: DialogueText
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            size_hint: 0.8, 0.7
            text: ""
            text_size: self.size
            font_size: 36
            font_name: "resources/armourui/font/poppins_medium.ttf"
            halign: 'left'
            color: (0, 0, 0, 1)
            valign: 'top'
            markup: True
        
        PixelImage:
            id: DialogueTitle
            allow_stretch: True
            pos_hint: {'x': 0.0, 'center_y': 1.05}
            source: 'resources/armourui/graphics/interface/titlebox.png'
        

# CHOICE 1
    RelativeLayout:
        id: ChoiceWindow_1
        pos_hint: {'x': 0.49, 'y': 0.33}
        size_hint: 0.3, 0.1

        PixelImage:
            id: ChoiceBackground_1
            allow_stretch: True
            source: 'ulivy/interface/modernui/dialogue_choice.png'
        
        BoxLayout:
            id: ChoiceScreen_1
            orientation: 'vertical'

        Label:
            id: ChoiceText_1
            text: ""
            color: (0, 0, 0, 1)
            allow_stretch: True
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            size_hint: 0.9, 0.6
            text_size: self.size
            font_size: 36
            font_name: "resources/armourui/font/poppins_medium.ttf"
            halign: 'left'
            valign: 'top'
            markup: True

