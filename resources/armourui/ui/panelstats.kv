        AliasImage:
            id: BoxB
            allow_stretch: True
            keep_ratio: True
            pos_hint: {'x': 0.0, 'center_y': 0.325}
            
            source: 'resources/armourui/graphics/interface/mon/inspect/stats/box_b.png'

        AliasImage:
            id: BoxC
            allow_stretch: True
            keep_ratio: True
            pos_hint: {'x': 0.0, 'center_y': 0.175}
            
            source: 'resources/armourui/graphics/interface/mon/inspect/stats/box_c.png'
