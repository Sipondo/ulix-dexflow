#:kivy 2.0.0

<PanelStats>
    RelativeLayout:
        id: Window
        opacity: 1

        AliasImage:
            id: BoxA
            allow_stretch: True
            keep_ratio: True
            pos_hint: {'x': 0.0, 'center_y': 0.6}
            
